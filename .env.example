# Copy this file to .env before running Docker Compose.
# Replace every angle-bracket placeholder with a local value.

POSTGRES_DB=manageflow
POSTGRES_USER=manageflow
POSTGRES_PASSWORD=<set-a-local-postgres-password>

# Must be a Base64-encoded JWT signing secret with sufficient entropy.
JWT_SECRET=<set-a-base64-encoded-jwt-secret>

# Used only to bootstrap the first ADMIN in a fresh PostgreSQL volume.
ADMIN_USERNAME=<set-an-initial-admin-username>
ADMIN_PASSWORD=<set-an-initial-admin-password>

FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
VITE_API_URL=http://localhost:8080
BUSINESS_TIME_ZONE=Europe/Athens
